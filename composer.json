{
  "name": "codesignificant/api-pro",
  "description": "API PRO – Lightweight PHP REST API framework",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=7.4",
    "ext-redis": "*"
  },
  "autoload": {
    "files": [
      "Core/autoload.php"
    ]
  },
  "scripts": {
    "post-install-cmd": [
      "php post-install.php"
    ],
    "post-update-cmd": [
      "php post-install.php"
    ],
    "start": [
      "php -S 127.0.0.1:7070 index.php"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}